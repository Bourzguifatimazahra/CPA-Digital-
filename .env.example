# Copier ce fichier en .env.local (ignoré par git) et y coller la clé Gemini.
# Clé gratuite : https://aistudio.google.com — projet dédié, facturation JAMAIS activée,
# clé restreinte aux sites cpa.ma/* et localhost/* et à l'API "Generative Language".
VITE_GEMINI_API_KEY=
# Optionnel : modèle Gemini prioritaire (défaut : gemini-flash-lite-latest, puis gemini-flash-latest si saturé)
VITE_GEMINI_MODEL=
